@{
    Layout = null;
    ViewBag.Title = "Đang kết nối";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Wazuh Security — Đang kết nối</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <style>
        :root{--bg:#0b0e14;--card:#111620;--brd:#1f2a3d;--acc:#00d4ff;--err:#ff4560;
              --ok:#00e396;--t1:#e8edf5;--t2:#8a97af;--t3:#4a5568;
              --sans:'Be Vietnam Pro','Segoe UI',Arial,sans-serif;
              --mono:'JetBrains Mono',monospace;}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        body{font-family:var(--sans);background:var(--bg);color:var(--t1);min-height:100vh;
            display:flex;align-items:center;justify-content:center;
            position:relative;overflow:hidden;
            -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
        body::before{content:'';position:fixed;inset:0;
            background-image:linear-gradient(rgba(0,212,255,.03) 1px,transparent 1px),
                             linear-gradient(90deg,rgba(0,212,255,.03) 1px,transparent 1px);
            background-size:40px 40px;animation:gs 20s linear infinite}
        @@keyframes gs{0%{background-position:0 0}100%{background-position:40px 40px}}
        .orb{position:fixed;border-radius:50%;filter:blur(80px);pointer-events:none}
        .orb1{width:400px;height:400px;background:rgba(0,212,255,.07);top:-100px;left:-100px}
        .orb2{width:300px;height:300px;background:rgba(102,126,234,.06);bottom:-50px;right:-50px}

        .box{background:var(--card);border:1px solid var(--brd);border-radius:16px;
            padding:48px 42px;width:100%;max-width:400px;
            position:relative;z-index:1;box-shadow:0 24px 64px rgba(0,0,0,.5);
            display:flex;flex-direction:column;align-items:center;text-align:center;gap:0}

        .brand{display:flex;align-items:center;gap:12px;margin-bottom:36px;align-self:flex-start}
        .brand-icon{width:44px;height:44px;background:linear-gradient(135deg,var(--acc),#0088cc);
            border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px}
        .brand-name{font-size:20px;font-weight:700;text-align:left}
        .brand-sub{font-size:11px;color:var(--t2);letter-spacing:1.5px;text-transform:uppercase;text-align:left}

        /* Spinner ring */
        .ring-wrap{position:relative;width:80px;height:80px;margin-bottom:28px}
        .ring{width:80px;height:80px;border-radius:50%;
            border:3px solid var(--brd);
            border-top-color:var(--acc);
            animation:spin .9s linear infinite}
        @@keyframes spin{to{transform:rotate(360deg)}}
        .ring-icon{position:absolute;inset:0;display:flex;align-items:center;
            justify-content:center;font-size:26px}

        .conn-title{font-size:18px;font-weight:700;color:var(--t1);margin-bottom:8px}
        .conn-sub{font-size:13px;color:var(--t2);line-height:1.6;margin-bottom:28px}

        /* Step dots */
        .steps{display:flex;flex-direction:column;gap:10px;width:100%;margin-bottom:28px}
        .step{display:flex;align-items:center;gap:10px;padding:10px 14px;
            border-radius:8px;background:var(--panel, #161c28);border:1px solid var(--brd);
            font-size:12.5px;color:var(--t2);text-align:left}
        .step-dot{width:8px;height:8px;border-radius:50%;background:var(--t3);flex-shrink:0;transition:all .3s}
        .step.done .step-dot{background:var(--ok);box-shadow:0 0 6px var(--ok)}
        .step.active .step-dot{background:var(--acc);box-shadow:0 0 6px var(--acc);animation:blink 1s infinite}
        .step.error .step-dot{background:var(--err);box-shadow:0 0 6px var(--err)}
        @@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
        .step-txt{flex:1}
        .step-check{font-size:14px}

        /* Error state */
        .err-box{width:100%;background:rgba(255,69,96,.1);border:1px solid rgba(255,69,96,.3);
            color:var(--err);padding:12px 16px;border-radius:8px;
            font-size:13px;text-align:left;line-height:1.6;margin-bottom:16px;display:none}
        .btn-retry{width:100%;background:linear-gradient(135deg,var(--acc),#0088cc);color:#000;
            border:none;padding:11px;border-radius:8px;font-size:14px;font-weight:700;
            cursor:pointer;font-family:var(--sans);transition:opacity .15s;display:none}
        .btn-retry:hover{opacity:.85}

        .footer-row{margin-top:8px;padding-top:18px;border-top:1px solid var(--brd);
            display:flex;align-items:center;gap:8px;width:100%}
        .dot-s{width:7px;height:7px;background:var(--ok);border-radius:50%;
            box-shadow:0 0 6px var(--ok);animation:blink 2s ease-in-out infinite}
        .sv{font-size:11px;color:var(--t2)}
        .sv-url{font-family:var(--mono);font-size:10px;color:var(--t3);margin-left:auto}
    </style>
</head>
<body>
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="box">
        <div class="brand">
            <div class="brand-icon">🛡️</div>
            <div>
                <div class="brand-name">WazuhWeb</div>
                <div class="brand-sub">Security Console</div>
            </div>
        </div>
        <div class="ring-wrap">
            <div class="ring" id="ring"></div>
            <div class="ring-icon" id="ringIcon">🔐</div>
        </div>
        <div class="conn-title" id="mainTitle">Đang kết nối...</div>
        <div class="conn-sub" id="mainSub">Đang xác thực với Wazuh Manager</div>
        <div class="steps">
            <div class="step active" id="step1">
                <div class="step-dot"></div>
                <div class="step-txt">Kết nối Wazuh Manager</div>
                <div class="step-check" id="chk1"></div>
            </div>
            <div class="step" id="step2">
                <div class="step-dot"></div>
                <div class="step-txt">Xác thực tài khoản</div>
                <div class="step-check" id="chk2"></div>
            </div>
            <div class="step" id="step3">
                <div class="step-dot"></div>
                <div class="step-txt">Lấy JWT token</div>
                <div class="step-check" id="chk3"></div>
            </div>
        </div>
        @if (ViewBag.Error != null)
        {
            <div class="err-box" id="errBox" style="display:block">
                ⚠️ Không kết nối được Wazuh Manager:<br />
                <strong>@ViewBag.Error</strong>
            </div>
            <button class="btn-retry" id="btnRetry" style="display:block"
                    onclick="window.location.reload()">
                🔄 Thử lại
            </button>
        }
        <div class="footer-row">
            <div class="dot-s"></div>
            <span class="sv">Wazuh Manager</span>
            <span class="sv-url">192.168.1.28:55000</span>
        </div>
    </div>
    <script>
@if(ViewBag.Error == null)
{
    // Không có lỗi → đang loading, animate steps rồi redirect
    <text>
    (function(){
        var steps = ['step1','step2','step3'];
        var checks= ['chk1','chk2','chk3'];
        var delays= [400, 900, 1400];

        steps.forEach(function(id,i){
            setTimeout(function(){
                // Mark previous done
                if(i>0){
                    document.getElementById(steps[i-1]).className='step done';
                    document.getElementById(checks[i-1]).textContent='✓';
                }
                document.getElementById(id).className='step active';
            }, delays[i]);
        });

        // Sau bước cuối → done + redirect
        setTimeout(function(){
            document.getElementById('step3').className='step done';
            document.getElementById('chk3').textContent='✓';
            document.getElementById('ring').style.borderTopColor='#00e396';
            document.getElementById('ringIcon').textContent='✅';
            document.getElementById('mainTitle').textContent='Kết nối thành công!';
            document.getElementById('mainSub').textContent='Đang chuyển hướng...';
            // Trang đã được render sau khi server redirect thành công
            // Trường hợp này không xảy ra vì server đã redirect trước
        }, 2000);
    })();
    </text>
}
else
{
    // Có lỗi → đánh dấu tất cả steps là error
    <text>
    (function(){
        ['step1','step2','step3'].forEach(function(id){
            document.getElementById(id).className='step error';
        });
        document.getElementById('ring').style.animation='none';
        document.getElementById('ring').style.borderTopColor='#ff4560';
        document.getElementById('ringIcon').textContent='❌';
        document.getElementById('mainTitle').textContent='Kết nối thất bại';
        document.getElementById('mainSub').textContent='Không thể kết nối đến Wazuh Manager';
    })();
    </text>
}
    </script>
</body>
</html>
