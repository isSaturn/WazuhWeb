@model WazuhWeb.Models.AgentData
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Agents";
    string dateFrom = ViewBag.DateFrom as string ?? "";
    string dateTo = ViewBag.DateTo as string ?? "";
    bool filtered = !string.IsNullOrEmpty(dateFrom) || !string.IsNullOrEmpty(dateTo);
}
<style>

    .stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px;
        margin-bottom: 20px
    }

    .sc {
        background: var(--card);
        border: 1px solid var(--brd);
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px
    }

    .si {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0
    }

    .sv {
        font-size: 26px;
        font-weight: 700;
        font-family: var(--mono);
        line-height: 1
    }

    .sk {
        font-size: 11px;
        color: var(--t2);
        margin-top: 3px
    }

    .ag-name {
        font-weight: 600;
        color: var(--t1);
        font-size: 13px
    }

    .ag-id {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--t3);
        background: var(--panel);
        padding: 1px 6px;
        border-radius: 4px;
        border: 1px solid var(--brd);
        margin-left: 6px
    }

    .acts {
        display: flex;
        gap: 5px;
        flex-wrap: wrap
    }

    .al {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--brd);
        color: var(--t2);
        background: var(--panel);
        transition: all .15s;
        white-space: nowrap
    }

        .al:hover {
            border-color: var(--acc);
            color: var(--acc);
            background: var(--acc-d)
        }

    .top-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        flex-wrap: wrap
    }
</style>
@{
    var items = Model?.affected_items ?? new System.Collections.Generic.List<WazuhWeb.Models.Agent>();
    int total = items.Count;
    int active = items.Count(a => a.status == "active");
    int offline = total - active;
    int wins = items.Count(a => a.os?.platform == "windows");
    int lin = items.Count(a => a.os?.platform == "ubuntu" || a.os?.platform == "linux");
}
@*<%-- Date Filter --%>*@
@using (Html.BeginForm("Index", "Agents", FormMethod.Get))
{
    <div class="filter-bar">
        <label>📅 Lọc theo ngày thêm:</label>
        <input type="date" name="dateFrom" value="@dateFrom" />
        <span style="color:var(--t3);font-size:12px">đến</span>
        <input type="date" name="dateTo" value="@dateTo" />
        <button type="submit" class="btn-filter">Lọc</button>
        @if (filtered)
        {
            <a href="@Url.Action("Index","Agents")" class="btn-reset">✕ Bỏ lọc</a>
            <span class="filter-active-label">Đang lọc</span>
        }
    </div>
}
<div class="stats">
    <div class="sc">
        <div class="si" style="background:var(--acc-d)">🖥️</div>
        <div><div class="sv" style="color:var(--acc)">@total</div><div class="sk">Tổng số Agents</div></div>
    </div>
    <div class="sc">
        <div class="si" style="background:var(--ok-d)">✅</div>
        <div><div class="sv" style="color:var(--ok)">@active</div><div class="sk">Đang hoạt động</div></div>
    </div>
    <div class="sc">
        <div class="si" style="background:var(--err-d)">⚠️</div>
        <div><div class="sv" style="color:var(--err)">@offline</div><div class="sk">Offline</div></div>
    </div>
    <div class="sc">
        <div class="si" style="background:var(--warn-d)">🪟</div>
        <div><div class="sv" style="color:var(--warn)">@wins</div><div class="sk">Win / @lin Linux</div></div>
    </div>
</div>
<div class="top-row">
    <div style="font-size:13px;color:var(--t2)">@total agents @(filtered ? "(đang lọc)" : "")</div>
    <div style="margin-left:auto">
        <button class="btn-ai" onclick="runAnalysis('AnalyzeAgents','Báo cáo Agents — Toàn hệ thống',{})">
            <span class="spin-i"></span><span class="ai-lbl">🤖 Phân tích AI Agents</span>
        </button>
    </div>
</div>
<div class="card">
    <div class="card-h">
        <span style="font-size:16px">🖥️</span>
        <span class="card-t">Danh sách Agents</span>
        <span class="card-c">@total agents</span>
    </div>
    @if (items.Any())
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>Agent</th>
                    <th>IP</th>
                    <th>Hệ điều hành</th>
                    <th>Phiên bản</th>
                    <th>Trạng thái</th>
                    <th>Keep Alive</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in items)
                {
                    string osi = a.os?.platform == "windows" ? "🪟" : a.os?.platform == "ubuntu" ? "🐧" : "💻";
                    string scls = a.status == "active" ? "bg-ok" : "bg-err";
                    <tr>
                        <td>@osi <span class="ag-name">@a.name</span><span class="ag-id">#@a.id</span></td>
                        <td><span class="mono">@a.ip</span></td>
                        <td style="font-size:12px">@(a.os != null ? $"{a.os.name} {a.os.version}" : "—")</td>
                        <td><span class="mono">@a.version</span></td>
                        <td><span class="badge @scls">@a.status</span></td>
                        <td><span class="mono" style="font-size:10px">@(a.lastKeepAlive?.Length > 10 ? a.lastKeepAlive.Substring(0, 10) : a.lastKeepAlive)</span></td>
                        <td>
                            @if (a.id != "000")
                            {
                                <div class="acts">
                                    <a href="@Url.Action("Index","Syscheck",new{agentId=a.id})" class="al">📁 Syscheck</a>
                                    <a href="@Url.Action("Index","Sca",new{agentId=a.id})" class="al">✅ SCA</a>
                                    <a href="@Url.Action("Index","Rootcheck",new{agentId=a.id})" class="al">🔍 Root</a>
                                </div>
                            }
                            else
                            {<span style="font-size:11px;color:var(--t3)">Manager</span>}
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="padding:40px;text-align:center;color:var(--t3)">Không có agent nào.</div>
    }
</div>
<script>function runAnalysis(action,title,extra){
    var btns=document.querySelectorAll('.btn-ai');
    btns.forEach(b=>{b.disabled=true;b.classList.add('loading')});
    openModal(title);
    document.getElementById('mLoadModel').textContent='Đang kết nối Ollama...';
    var params=new URLSearchParams(extra||{});
    params.append('__RequestVerificationToken',getToken());
    fetch('/Analysis/'+action,{method:'POST',
        headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:params.toString()})
    .then(r=>r.json()).then(d=>{showResult(d)})
    .catch(e=>showResult({success:false,error:e.message}))
    .finally(()=>btns.forEach(b=>{b.disabled=false;b.classList.remove('loading')}));
}</script>
