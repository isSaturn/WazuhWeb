@model WazuhWeb.Models.RootcheckViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Rootcheck";
    ViewBag.Subtitle = $"Agent #{ViewBag.AgentId} — Rootkit & Suspicious Findings";
}
@using WazuhWeb.Models
<style>

    /* ── AGENT SELECT BAR ── */
    .agent-select-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        background: var(--card);
        border: 1px solid var(--brd);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 18px;
    }

        .agent-select-bar label {
            font-size: 12px;
            color: var(--t2);
            font-weight: 600;
            white-space: nowrap;
        }

        .agent-select-bar select {
            background: var(--panel);
            border: 1px solid var(--brd);
            color: var(--t1);
            padding: 6px 10px;
            border-radius: 7px;
            font-size: 12px;
            font-family: var(--sans);
            cursor: pointer;
        }

            .agent-select-bar select:focus {
                outline: none;
                border-color: var(--acc);
            }

    .btn-go {
        background: var(--acc);
        color: #000;
        border: none;
        padding: 6px 16px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--sans);
        transition: opacity .15s;
        white-space: nowrap;
    }

        .btn-go:hover {
            opacity: .85;
        }

    /* ── SUMMARY BANNER ── */
    .summary-banner {
        background: var(--err-d);
        border: 1px solid rgba(255,69,96,.3);
        border-radius: 10px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
    }

        .summary-banner.clean {
            background: var(--ok-d);
            border-color: rgba(0,227,150,.3);
        }

    .banner-icon {
        font-size: 32px;
    }

    .banner-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--t1);
    }

    .banner-sub {
        font-size: 12px;
        color: var(--t2);
        margin-top: 2px;
    }

    /* ── CARD HEADER ── */
    .card-header {
        padding: 14px 18px;
        border-bottom: 1px solid var(--brd);
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--panel);
    }

    .card-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--t1);
    }

    .card-count {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--t2);
        background: var(--panel);
        padding: 2px 8px;
        border-radius: 20px;
        border: 1px solid var(--brd);
        margin-left: auto;
    }

    /* ── FINDING CARDS ── */
    .finding-card {
        background: var(--card);
        border: 1px solid var(--brd);
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 10px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        align-items: start;
        transition: border-color .15s;
    }

        .finding-card:hover {
            border-color: rgba(255,69,96,.3);
        }

        .finding-card.pci {
            border-left: 3px solid var(--warn);
        }

    .finding-log {
        font-size: 13px;
        color: var(--t1);
        font-weight: 500;
        line-height: 1.5;
        margin-bottom: 8px;
    }

    .finding-meta {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

    .finding-dates {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--t3);
    }

    /* ── STATUS BADGES ── */
    .status-outstanding {
        background: var(--err-d);
        color: var(--err);
        border: 1px solid rgba(255,69,96,.25);
    }

    .status-resolved {
        background: var(--ok-d);
        color: var(--ok);
        border: 1px solid rgba(0,227,150,.25);
    }

    .pci-badge {
        background: var(--warn-d);
        color: var(--warn);
        border: 1px solid rgba(255,181,71,.25);
        font-family: var(--mono);
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--t3);
    }

        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .empty-state .msg {
            font-size: 14px;
        }
</style>
<!-- Agent selector -->
<div class="agent-select-bar">
    <label>Agent ID:</label>
    <select id="agentSelect">
        @if (ViewBag.AllAgents != null)
        {
            foreach (var agent in (List<WazuhWeb.Models.Agent>)ViewBag.AllAgents)
            {
                <option value="@agent.id"
                        @(ViewBag.AgentId == agent.id ? "selected" : "")>
                    @agent.id — @agent.name
                </option>
            }
        }
    </select>
    <button class="btn-go" onclick="goToAgent()">Xem →</button>
</div>
@{
    int total = Model.Total;
    bool hasFindings = total > 0;
}
<!-- Banner -->
@if (hasFindings)
{
    <div class="summary-banner">
        <div class="banner-icon">🚨</div>
        <div>
            <div class="banner-title">Phát hiện @total vấn đề bảo mật</div>
            <div class="banner-sub">Agent #@ViewBag.AgentId có các phát hiện nguy hiểm cần xem xét ngay.</div>
        </div>
        <div style="margin-left:auto">
            <span class="badge bg-err" style="font-size:13px;padding:6px 14px">@total findings</span>
        </div>
    </div>
}
else
{
    <div class="summary-banner clean">
        <div class="banner-icon">✅</div>
        <div>
            <div class="banner-title">Không phát hiện rootkit</div>
            <div class="banner-sub">Agent #@ViewBag.AgentId sạch.</div>
        </div>
    </div>
}
<!-- Findings list -->
@if (hasFindings)
{
    <div class="card" style="padding:16px">
        <div class="card-header" style="margin:-16px -16px 16px; border-radius:12px 12px 0 0">
            <span style="font-size:16px">🔍</span>
            <span class="card-title">Danh sách phát hiện</span>
            <span class="card-count">@total items</span>
        </div>
        @foreach (var item in Model.Items)
        {
            string statusClass = item.status == "outstanding" ? "status-outstanding" : "status-resolved";
            bool hasPci = !string.IsNullOrEmpty(item.pci_dss);

            <div class="finding-card @(hasPci ? "pci" : "")">
                <div>
                    <div class="finding-log">@item.log</div>
                    <div class="finding-meta">
                        <span class="badge @statusClass">
                            @(item.status == "outstanding" ? "⚠ Outstanding" : "✓ Resolved")
                        </span>
                        @if (hasPci)
                        {
                            <span class="badge pci-badge">PCI DSS @item.pci_dss</span>
                        }
                        <span class="finding-dates">
                            Phát hiện: @(item.date_first?.Length > 10 ? item.date_first.Substring(0, 10) : item.date_first)
                            &nbsp;|&nbsp;
                            Cuối: @(item.date_last?.Length > 10 ? item.date_last.Substring(0, 10) : item.date_last)
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <div class="icon">🛡️</div>
            <div class="msg">Không có rootkit hoặc phần mềm nguy hiểm nào được phát hiện.</div>
        </div>
    </div>
}
<script>
    function goToAgent() {
        var id = document.getElementById('agentSelect').value;
        var base = '@Url.Action("Index", "Rootcheck")';
        window.location.href = base + '?agentId=' + id;
    }
</script>
