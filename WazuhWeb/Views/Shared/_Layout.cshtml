<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewBag.Title - Wazuh Security</title>
    @*<%-- Be Vietnam Pro: font tiếng Việt đầy đủ dấu thanh --%>*@
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    @*<%-- marked.js render Markdown --%>*@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
    @*<%-- html2pdf.js để tải PDF --%>*@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root{
            --bg:     #0b0e14;
            --card:   #111620;
            --panel:  #161c28;
            --brd:    #1f2a3d;
            --acc:    #00d4ff;
            --acc-d:  rgba(0,212,255,.12);
            --err:    #ff4560;
            --err-d:  rgba(255,69,96,.12);
            --ok:     #00e396;
            --ok-d:   rgba(0,227,150,.12);
            --warn:   #ffb547;
            --warn-d: rgba(255,181,71,.12);
            --t1:     #e8edf5;
            --t2:     #8a97af;
            --t3:     #4a5568;
            --sw:     244px;
            --mono:  'JetBrains Mono',monospace;
            --sans:  'Be Vietnam Pro','Segoe UI',Arial,sans-serif;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{font-size:14px}
        body{
            font-family:var(--sans);
            background:var(--bg);color:var(--t1);
            display:flex;min-height:100vh;
            -webkit-font-smoothing:antialiased;
            text-rendering:optimizeLegibility;
        }

        /* ── SIDEBAR ── */
        .sidebar{
            width:var(--sw);background:var(--card);border-right:1px solid var(--brd);
            display:flex;flex-direction:column;
            position:fixed;top:0;left:0;bottom:0;z-index:100;overflow-y:auto;
        }
        .sb-logo{padding:20px 16px 16px;border-bottom:1px solid var(--brd);flex-shrink:0}
        .sb-logo .brand{display:flex;align-items:center;gap:10px}
        .sb-logo .icon{width:34px;height:34px;background:linear-gradient(135deg,var(--acc),#0088cc);
            border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
        .sb-logo .name{font-weight:700;font-size:15px;color:var(--t1)}
        .sb-logo .sub{font-size:10px;color:var(--t2);letter-spacing:1.2px;text-transform:uppercase;margin-top:1px}
        .sb-nav{flex:1;padding:12px 10px;display:flex;flex-direction:column;gap:3px}
        .nav-lbl{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--t3);
            padding:10px 8px 4px;font-weight:600}
        .nav-a{
            display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:8px;
            color:var(--t2);text-decoration:none;font-size:13px;font-weight:500;
            transition:all .15s;position:relative;white-space:nowrap;
        }
        .nav-a:hover{background:var(--panel);color:var(--t1)}
        .nav-a.on{background:var(--acc-d);color:var(--acc);border:1px solid rgba(0,212,255,.2)}
        .nav-a.on::before{content:'';position:absolute;left:0;top:20%;bottom:20%;
            width:3px;background:var(--acc);border-radius:0 2px 2px 0}
        .nav-a .ic{font-size:15px;width:19px;text-align:center;flex-shrink:0}
        .ollama-pill{
            display:flex;align-items:center;gap:7px;
            padding:7px 11px;border-radius:7px;background:var(--panel);
            border:1px solid var(--brd);margin:0 0 4px;font-size:11px;color:var(--t2);
        }
        .o-dot{width:7px;height:7px;border-radius:50%;background:var(--t3);flex-shrink:0}
        .o-dot.up{background:var(--ok);box-shadow:0 0 5px var(--ok);animation:blink 2s infinite}
        .o-dot.dn{background:var(--err)}
        @@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
        .o-model{font-family:var(--mono);font-size:10px;color:var(--t3)}
        .sb-footer{padding:12px 10px;border-top:1px solid var(--brd);flex-shrink:0}
        .user-row{display:flex;align-items:center;gap:8px;padding:8px;border-radius:8px;background:var(--panel)}
        .u-av{width:30px;height:30px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:50%;
            display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;flex-shrink:0}
        .u-name{font-size:12px;font-weight:600;color:var(--t1)}
        .u-role{font-size:10px;color:var(--t2)}
        .logout{margin-left:auto;background:none;border:none;color:var(--t3);cursor:pointer;
            font-size:15px;padding:4px;border-radius:4px;transition:color .15s}
        .logout:hover{color:var(--err)}

        /* ── MAIN ── */
        .main{margin-left:var(--sw);flex:1;display:flex;flex-direction:column;min-height:100vh}
        .topbar{
            height:56px;background:var(--card);border-bottom:1px solid var(--brd);
            display:flex;align-items:center;padding:0 24px;gap:10px;
            position:sticky;top:0;z-index:50;
        }
        .tb-title{font-size:15px;font-weight:700;color:var(--t1)}
        .tb-sub{font-size:12px;color:var(--t3)}
        .tb-space{flex:1}
        .tb-clock{font-family:var(--mono);font-size:11px;color:var(--t3);
            background:var(--panel);padding:4px 10px;border-radius:6px;border:1px solid var(--brd)}
        .page{padding:24px;flex:1}

        /* ── CARDS & TABLE ── */
        .card{background:var(--card);border:1px solid var(--brd);border-radius:12px;overflow:hidden}
        .card-h{padding:14px 18px;border-bottom:1px solid var(--brd);display:flex;align-items:center;gap:10px}
        .card-t{font-size:13px;font-weight:600;color:var(--t1)}
        .card-c{font-family:var(--mono);font-size:11px;color:var(--t2);background:var(--panel);
            padding:2px 8px;border-radius:20px;border:1px solid var(--brd);margin-left:auto}
        .tbl{width:100%;border-collapse:collapse}
        .tbl th{padding:9px 14px;text-align:left;font-size:10px;font-weight:600;
            letter-spacing:1.1px;text-transform:uppercase;color:var(--t3);
            background:var(--panel);border-bottom:1px solid var(--brd)}
        .tbl td{padding:10px 14px;border-bottom:1px solid rgba(31,42,61,.6);
            font-size:12.5px;color:var(--t2);vertical-align:middle}
        .tbl tr:last-child td{border-bottom:none}
        .tbl tr:hover td{background:rgba(255,255,255,.02)}
        .mono{font-family:var(--mono);font-size:11px}

        /* ── BADGES ── */
        .badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;
            border-radius:20px;font-size:11px;font-weight:600}
        .bg-ok  {background:var(--ok-d);color:var(--ok);border:1px solid rgba(0,227,150,.25)}
        .bg-err {background:var(--err-d);color:var(--err);border:1px solid rgba(255,69,96,.25)}
        .bg-w   {background:var(--warn-d);color:var(--warn);border:1px solid rgba(255,181,71,.25)}
        .bg-inf {background:var(--acc-d);color:var(--acc);border:1px solid rgba(0,212,255,.25)}
        .bg-n   {background:var(--panel);color:var(--t2);border:1px solid var(--brd)}

        /* ── DATE FILTER BAR ── */
        .filter-bar{
            display:flex;align-items:center;gap:10px;flex-wrap:wrap;
            background:var(--card);border:1px solid var(--brd);border-radius:10px;
            padding:12px 16px;margin-bottom:18px;
        }
        .filter-bar label{font-size:12px;color:var(--t2);font-weight:600;white-space:nowrap}
        .filter-bar input[type=date]{
            background:var(--panel);border:1px solid var(--brd);color:var(--t1);
            padding:6px 10px;border-radius:7px;font-size:12px;font-family:var(--sans);
            color-scheme:dark;
        }
        .filter-bar input[type=date]:focus{outline:none;border-color:var(--acc)}
        .filter-bar select{
            background:var(--panel);border:1px solid var(--brd);color:var(--t1);
            padding:6px 10px;border-radius:7px;font-size:12px;font-family:var(--sans);cursor:pointer;
        }
        .filter-bar select:focus{outline:none;border-color:var(--acc)}
        .btn-filter{
            background:var(--acc);color:#000;border:none;padding:6px 16px;
            border-radius:7px;font-size:12px;font-weight:700;cursor:pointer;
            font-family:var(--sans);transition:opacity .15s;white-space:nowrap;
        }
        .btn-filter:hover{opacity:.85}
        .btn-reset{
            background:var(--panel);color:var(--t2);border:1px solid var(--brd);
            padding:6px 12px;border-radius:7px;font-size:12px;cursor:pointer;
            font-family:var(--sans);
        }
        .btn-reset:hover{color:var(--t1);border-color:var(--t2)}
        .filter-active-label{
            font-size:11px;color:var(--warn);background:var(--warn-d);
            border:1px solid rgba(255,181,71,.3);padding:2px 8px;border-radius:20px;
        }

        /* ── AI BUTTON ── */
        .btn-ai{
            display:inline-flex;align-items:center;gap:7px;
            background:linear-gradient(135deg,#7c3aed,#4f46e5);
            color:#fff;border:none;padding:8px 18px;border-radius:8px;
            font-size:13px;font-weight:600;cursor:pointer;font-family:var(--sans);
            transition:all .2s;box-shadow:0 2px 12px rgba(124,58,237,.35);
        }
        .btn-ai:hover{opacity:.9;transform:translateY(-1px);box-shadow:0 4px 20px rgba(124,58,237,.45)}
        .btn-ai:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
        .btn-ai .spin-i{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);
            border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:none}
        .btn-ai.loading .spin-i{display:block}
        .btn-ai.loading .ai-lbl{display:none}
        @@keyframes spin{to{transform:rotate(360deg)}}

        /* ── MODAL ── */
        .modal-ov{
            display:none;position:fixed;inset:0;z-index:1000;
            background:rgba(0,0,0,.75);backdrop-filter:blur(4px);
            align-items:flex-start;justify-content:center;
            padding:32px 16px;overflow-y:auto;
        }
        .modal-ov.open{display:flex}
        .modal{
            background:var(--card);border:1px solid var(--brd);border-radius:14px;
            width:100%;max-width:880px;
            box-shadow:0 24px 80px rgba(0,0,0,.6);
            display:flex;flex-direction:column;max-height:90vh;
            animation:mIn .2s ease;
        }
        @@keyframes mIn{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}
        .modal-head{
            padding:16px 20px;border-bottom:1px solid var(--brd);
            display:flex;align-items:center;gap:12px;flex-shrink:0;
        }
        .modal-icon{width:36px;height:36px;background:linear-gradient(135deg,#7c3aed,#4f46e5);
            border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
        .modal-title{font-size:15px;font-weight:700;color:var(--t1)}
        .modal-meta{font-size:11px;color:var(--t3);margin-top:2px}
        .modal-x{
            margin-left:auto;background:var(--panel);border:1px solid var(--brd);
            color:var(--t2);width:30px;height:30px;border-radius:7px;cursor:pointer;
            font-size:15px;display:flex;align-items:center;justify-content:center;
            transition:all .15s;flex-shrink:0;
        }
        .modal-x:hover{background:var(--err-d);color:var(--err);border-color:rgba(255,69,96,.3)}
        .modal-body{
            padding:22px;overflow-y:auto;flex:1;
            line-height:1.78;font-size:13.5px;color:var(--t2);
        }
        /* Markdown styles */
        .modal-body h1{font-size:18px;color:var(--t1);font-weight:700;margin:0 0 14px;
            border-bottom:1px solid var(--brd);padding-bottom:8px}
        .modal-body h2{font-size:15px;color:var(--acc);font-weight:700;margin:20px 0 10px;
            display:flex;align-items:center;gap:7px}
        .modal-body h2::before{content:'';width:3px;height:16px;background:var(--acc);
            border-radius:2px;display:inline-block;flex-shrink:0}
        .modal-body h3{font-size:13px;color:var(--warn);font-weight:600;margin:14px 0 7px}
        .modal-body h4{font-size:12.5px;color:var(--t1);font-weight:600;margin:10px 0 5px}
        .modal-body p{margin:0 0 9px;color:var(--t2)}
        .modal-body ul,.modal-body ol{margin:5px 0 11px 20px}
        .modal-body li{margin:4px 0;color:var(--t2)}
        .modal-body li::marker{color:var(--acc)}
        .modal-body strong{color:var(--t1);font-weight:600}
        .modal-body em{color:var(--warn);font-style:italic}
        .modal-body code{font-family:var(--mono);font-size:11px;background:var(--panel);
            border:1px solid var(--brd);padding:1px 5px;border-radius:4px;color:#7dd3fc}
        .modal-body pre{background:#0b0e14;border:1px solid var(--brd);border-radius:8px;
            padding:12px 16px;margin:8px 0;overflow-x:auto}
        .modal-body pre code{background:none;border:none;padding:0;font-size:11.5px}
        .modal-body blockquote{border-left:3px solid var(--acc);padding:8px 14px;margin:8px 0;
            background:var(--acc-d);border-radius:0 6px 6px 0;color:var(--t2)}
        .modal-body hr{border:none;border-top:1px solid var(--brd);margin:14px 0}
        .modal-body table{width:100%;border-collapse:collapse;margin:8px 0;font-size:12px}
        .modal-body table th{background:var(--panel);padding:7px 12px;text-align:left;
            font-size:10px;color:var(--t3);letter-spacing:.8px;text-transform:uppercase}
        .modal-body table td{padding:7px 12px;border-bottom:1px solid rgba(31,42,61,.5)}
        .modal-foot{
            padding:12px 20px;border-top:1px solid var(--brd);
            display:flex;align-items:center;gap:10px;flex-shrink:0;flex-wrap:wrap;
        }
        .foot-info{font-size:11px;color:var(--t3)}
        .foot-info span{color:var(--acc);font-family:var(--mono)}
        .btn-copy{
            background:var(--panel);border:1px solid var(--brd);color:var(--t2);
            padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;
            cursor:pointer;font-family:var(--sans);transition:all .15s;
            display:flex;align-items:center;gap:6px;
        }
        .btn-copy:hover{border-color:var(--acc);color:var(--acc)}
        .btn-pdf{
            background:linear-gradient(135deg,#e11d48,#be123c);color:#fff;border:none;
            padding:6px 14px;border-radius:7px;font-size:12px;font-weight:600;
            cursor:pointer;font-family:var(--sans);transition:all .15s;
            display:flex;align-items:center;gap:6px;
        }
        .btn-pdf:hover{opacity:.85}
        .btn-pdf:disabled{opacity:.5;cursor:not-allowed}

        /* Loading state */
        .ai-load{display:flex;flex-direction:column;align-items:center;
            justify-content:center;padding:60px 20px;gap:16px}
        .ai-spinner{width:44px;height:44px;border:3px solid var(--brd);
            border-top-color:#7c3aed;border-radius:50%;animation:spin .8s linear infinite}
        .ai-load-txt{font-size:14px;color:var(--t2)}
        .ai-load-sub{font-size:12px;color:var(--t3);text-align:center}
        .alert-err{background:var(--err-d);border:1px solid rgba(255,69,96,.3);
            color:var(--err);padding:11px 15px;border-radius:8px;font-size:13px;margin-bottom:16px}

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar{width:5px;height:5px}
        ::-webkit-scrollbar-track{background:transparent}
        ::-webkit-scrollbar-thumb{background:var(--brd);border-radius:3px}
    </style>
</head>
<body>
    @*<%-- SIDEBAR --%>*@
    <nav class="sidebar">
        <div class="sb-logo">
            <div class="brand">
                <div class="icon">🛡️</div>
                <div>
                    <div class="name">WazuhWeb</div>
                    <div class="sub">Security Console</div>
                </div>
            </div>
        </div>
        <div class="sb-nav">
            <div class="nav-lbl">Giám sát</div>
            <a href="@Url.Action("Index","Agents")"
               class="nav-a @(ViewContext.RouteData.Values["controller"].ToString()=="Agents"?"on":"")">
                <span class="ic">🖥️</span> Agents
            </a>
            <a href="@Url.Action("Index","Syscheck",new{agentId=ViewBag.AgentId??"001"})"
               class="nav-a @(ViewContext.RouteData.Values["controller"].ToString()=="Syscheck"?"on":"")">
                <span class="ic">📁</span> File Integrity
            </a>
            <a href="@Url.Action("Index","Sca",new{agentId=ViewBag.AgentId??"001"})"
               class="nav-a @(ViewContext.RouteData.Values["controller"].ToString()=="Sca"?"on":"")">
                <span class="ic">✅</span> SCA Checks
            </a>
            <a href="@Url.Action("Index","Rootcheck",new{agentId=ViewBag.AgentId??"001"})"
               class="nav-a @(ViewContext.RouteData.Values["controller"].ToString()=="Rootcheck"?"on":"")">
                <span class="ic">🔍</span> Rootcheck
            </a>
            <div class="nav-lbl" style="margin-top:8px">Phân tích AI</div>
            <a href="@Url.Action("Index","Analysis")"
               class="nav-a @(ViewContext.RouteData.Values["controller"].ToString()=="Analysis"?"on":"")">
                <span class="ic">🤖</span> AI Reports
            </a>
            <div style="margin-top:8px">
                <div class="ollama-pill">
                    <div class="o-dot" id="ollamaDot"></div>
                    <div>
                        <div style="font-size:11px;color:var(--t2);font-weight:500">Ollama</div>
                        <div class="o-model" id="ollamaLbl">Đang kiểm tra...</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="sb-footer">
            <div class="user-row">
                <div class="u-av">@((Session["WazuhUser"] as string ?? "A").Substring(0, 1).ToUpper())</div>
                <div>
                    <div class="u-name">@(Session["WazuhUser"] ?? "admin")</div>
                    <div class="u-role">Administrator</div>
                </div>
            </div>
        </div>
    </nav>
    @*<%-- MAIN --%>*@
    <div class="main">
        <div class="topbar">
            <span class="tb-title">@ViewBag.Title</span>
            @if (ViewBag.Subtitle != null)
            {<span class="tb-sub">— @ViewBag.Subtitle</span>}
            <div class="tb-space"></div>
            <div class="tb-clock" id="clock"></div>
        </div>
        <div class="page">
            @if (ViewBag.Error != null)
            {<div class="alert-err">⚠️ @ViewBag.Error</div>}
            @RenderBody()
        </div>
    </div>
    @*<%-- ══ AI REPORT MODAL ══ --%>*@
    <div class="modal-ov" id="aiModal">
        <div class="modal" id="aiModalBox">
            <div class="modal-head">
                <div class="modal-icon">🤖</div>
                <div>
                    <div class="modal-title" id="mTitle">Báo cáo Phân tích AI</div>
                    <div class="modal-meta" id="mMeta"></div>
                </div>
                <button class="modal-x" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body" id="mBody">
                <div class="ai-load" id="mLoading">
                    <div class="ai-spinner"></div>
                    <div class="ai-load-txt">Đang phân tích dữ liệu bảo mật...</div>
                    <div class="ai-load-sub" id="mLoadModel">Vui lòng đợi, AI đang xử lý</div>
                </div>
                <div id="mContent" style="display:none"></div>
                <div id="mError" style="display:none"></div>
            </div>
            <div class="modal-foot">
                <div class="foot-info">
                    Model: <span id="mModel">—</span>
                    &nbsp;|&nbsp; Thời gian: <span id="mTime">—</span>
                </div>
                <button class="btn-copy" onclick="copyReport()">📋 Sao chép</button>
                <button class="btn-pdf" onclick="downloadPdf()" id="btnPdf" disabled>📄 Tải PDF</button>
            </div>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <script>
// ── CLOCK ──
(function tick(){
    document.getElementById('clock').textContent =
        new Date().toLocaleDateString('vi-VN') + ' ' + new Date().toLocaleTimeString('vi-VN');
    setTimeout(tick,1000);
})();

// ── OLLAMA STATUS ──
async function checkOllama(){
    try{
        const r = await fetch('@Url.Action("OllamaStatus","Analysis")');
        const d = await r.json();
        document.getElementById('ollamaDot').className = 'o-dot ' + (d.online?'up':'dn');
        document.getElementById('ollamaLbl').textContent = d.online ? (d.model||'online') : 'Offline';
    }catch{
        document.getElementById('ollamaDot').className='o-dot dn';
        document.getElementById('ollamaLbl').textContent='Không kết nối';
    }
}
checkOllama();

// ── MODAL ──
let _rawReport = '';

function openModal(title){
    _rawReport='';
    document.getElementById('mTitle').textContent   = title||'Báo cáo AI';
    document.getElementById('mMeta').textContent    = '';
    document.getElementById('mModel').textContent   = '—';
    document.getElementById('mTime').textContent    = '—';
    document.getElementById('mLoading').style.display='flex';
    document.getElementById('mContent').style.display='none';
    document.getElementById('mError').style.display='none';
    document.getElementById('btnPdf').disabled=true;
    document.getElementById('aiModal').classList.add('open');
    document.body.style.overflow='hidden';
}
function closeModal(){
    document.getElementById('aiModal').classList.remove('open');
    document.body.style.overflow='';
}
document.getElementById('aiModal').addEventListener('click',function(e){if(e.target===this)closeModal()});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});

function showResult(data){
    document.getElementById('mLoading').style.display='none';
    if(!data.success){
        var el=document.getElementById('mError');
        el.style.display='block';
        el.innerHTML=`<div class="alert-err"><strong>⚠ Lỗi AI</strong><br>
            <span style="font-size:12.5px">${esc(data.error||'Lỗi không xác định')}</span><br>
            <span style="font-size:11px;color:var(--t3);margin-top:6px;display:block">
                Đảm bảo Ollama đang chạy: <code>ollama serve</code> và đã pull model: <code>ollama pull</code>
            </span></div>`;
        return;
    }
    _rawReport=data.report||'';
    document.getElementById('mMeta').textContent='Phân tích lúc '+new Date().toLocaleString('vi-VN');
    document.getElementById('mModel').textContent=data.model||'—';
    document.getElementById('mTime').textContent=(data.duration?data.duration+'s':'—');
    var el=document.getElementById('mContent');
    el.style.display='block';
    if(window.marked){marked.setOptions({breaks:true,gfm:true});el.innerHTML=marked.parse(_rawReport);}
    else el.innerHTML='<pre style="white-space:pre-wrap">'+esc(_rawReport)+'</pre>';
    document.getElementById('btnPdf').disabled=false;
}

async function runAnalysis(action,title,extra){
    openModal(title);
    document.getElementById('mLoadModel').textContent='Model: '+(document.getElementById('ollamaLbl').textContent||'ollama');
    var params=new URLSearchParams(extra||{});
    params.append('__RequestVerificationToken',getToken());
    try{
        var r=await fetch('/Analysis/'+action,{method:'POST',
            headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body:params.toString()});
        showResult(await r.json());
    }catch(e){showResult({success:false,error:e.message})}
}

function getToken(){
    var el=document.querySelector('input[name="__RequestVerificationToken"]');
    return el?el.value:'';
}
function copyReport(){
    if(!_rawReport)return;
    navigator.clipboard.writeText(_rawReport).then(()=>{
        var b=document.querySelector('.btn-copy');
        b.textContent='✓ Đã sao chép!';
        setTimeout(()=>b.innerHTML='📋 Sao chép',2000);
    });
}
        function downloadPdf() {
            var btn = document.getElementById('btnPdf');
            btn.disabled = true; btn.textContent = '⏳ Đang tạo PDF...';

            var titleText = document.getElementById('mTitle').textContent;

            // Render markdown thành HTML sạch từ _rawReport (không dùng innerHTML dark theme)
            var cleanHtml = '';
            if (window.marked && _rawReport) {
                marked.setOptions({ breaks: true, gfm: true });
                cleanHtml = marked.parse(_rawReport);
            } else {
                cleanHtml = '<pre style="white-space:pre-wrap;font-size:12px">' + esc(_rawReport) + '</pre>';
            }

            var wrapper = document.createElement('div');
            wrapper.innerHTML = `
        <div style="font-family:'Be Vietnam Pro',Arial,sans-serif;color:#1a202c;padding:24px;background:#ffffff">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
                <div style="font-size:24px">🛡️</div>
                <div>
                    <div style="font-size:20px;font-weight:700;color:#0f172a">${esc(titleText)}</div>
                    <div style="font-size:11px;color:#64748b">Wazuh Security Console — ${new Date().toLocaleString('vi-VN')}</div>
                </div>
            </div>
            <hr style="border:none;border-top:2px solid #e2e8f0;margin:12px 0"/>
            <style>
                *{color:#1a202c !important}
                h1{font-size:17px;font-weight:700;color:#0f172a !important;margin:0 0 12px;
                    border-bottom:2px solid #3b82f6;padding-bottom:6px}
                h2{font-size:14px;font-weight:700;color:#1d4ed8 !important;margin:18px 0 8px}
                h3{font-size:13px;font-weight:600;color:#b45309 !important;margin:12px 0 6px}
                h4{font-size:12px;font-weight:600;color:#374151 !important;margin:8px 0 4px}
                p{font-size:12.5px;color:#374151 !important;line-height:1.7;margin:4px 0 8px}
                li{font-size:12.5px;color:#374151 !important;line-height:1.7;margin:3px 0}
                ul,ol{margin:4px 0 10px 18px}
                strong{color:#0f172a !important;font-weight:700}
                em{color:#92400e !important;font-style:italic}
                code{font-family:'Courier New',monospace;font-size:11px;
                    background:#f1f5f9 !important;color:#0369a1 !important;
                    padding:1px 5px;border-radius:3px;border:1px solid #e2e8f0}
                pre{background:#f8fafc !important;border:1px solid #e2e8f0;border-radius:6px;
                    padding:10px;margin:8px 0;overflow:hidden}
                pre code{font-size:10.5px;color:#334155 !important;
                    background:transparent !important;border:none;
                    white-space:pre-wrap;word-break:break-all}
                blockquote{border-left:3px solid #3b82f6;padding:6px 12px;margin:8px 0;
                    background:#eff6ff !important;border-radius:0 4px 4px 0}
                blockquote p{color:#1e40af !important;margin:0}
                hr{border:none;border-top:1px solid #e2e8f0;margin:12px 0}
                table{width:100%;border-collapse:collapse;font-size:11.5px;margin:10px 0}
                th{background:#f1f5f9 !important;color:#374151 !important;
                    padding:6px 10px;text-align:left;font-size:10px;
                    text-transform:uppercase;letter-spacing:.5px;
                    border:1px solid #e2e8f0;font-weight:600}
                td{padding:6px 10px;border:1px solid #e2e8f0;
                    color:#374151 !important;vertical-align:top}
                tr:nth-child(even) td{background:#f8fafc !important}
            </style>
            ${cleanHtml}
        </div>`;

            html2pdf().set({
                margin: [10, 10, 10, 10],
                filename: titleText.replace(/[^a-zA-Z0-9\u00C0-\u024F ]/g, '_').substring(0, 60) + '.pdf',
                image: { type: 'jpeg', quality: .98 },
                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    letterRendering: true,
                    backgroundColor: '#ffffff'   // ← đảm bảo nền trắng
                },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            }).from(wrapper).save().then(() => {
                btn.disabled = false;
                btn.innerHTML = '📄 Tải PDF';
            });
        }

function esc(s){return(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
    </script>
</body>
</html>
